resource "aws_lb_listener" "front_end" {
  load_balancer_arn = "aef2c07d11cc14041a0b55854b28882d-2129224609.ap-northeast-1.elb.amazonaws.com"
  port              = "80"
  protocol          = "HTTP"

  default_action {
    type = "redirect"

    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}