module haproxy-ingress-controller {
  source  = "github.com/sanarena/terraform-kubernetes-haproxy-ingress-controller"
  # however recommended way is to add this repository as a submodule

  # optional
  name = "haproxy"
  controller_replicas = "2"
  #load_balancer_source_ranges = ["1.2.3.4/32"]

  #for extra services:
  /*
  tcp_services = {
    "panel" = {
      namespace="default"
      service_name="controlpanel"
      container_port="80"
      ingress_port="8081"
    },
    "mysql" = {
      namespace="default"
      service_name="mysql"
      container_port="3306"
      ingress_port="3306"
    }
  }
  udp_services = {
    "openvpn" = {
      namespace="default"
      service_name="openvpn"
      container_port="1194"
      ingress_port="1194"
    }
  }
  */
  #for extra services:
  lb_annotations = {
    "service.beta.kubernetes.io/aws-load-balancer-name": "eks-lb"
    "service.beta.kubernetes.io/aws-load-balancer-type": "nlb"
    "service.beta.kubernetes.io/aws-load-balancer-scheme": "internet-facing"
    "service.beta.kubernetes.io/aws-load-balancer-connection-idle-timeout": 360
    "service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags": "Dept=VNTeam, Team=${local.team}, ManageBy=vnTerraform, Environment=${local.environment}"
  }
}
    #"service.beta.kubernetes.io/aws-load-balancer-ssl-cert" : "${data.terraform_remote_state.acm_cert.outputs.aws_acm_certificate_main}"
    #"service.beta.kubernetes.io/aws-load-balancer-name": "${var.environment}-${var.team}-eks-lb"
    #service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
    #service.beta.kubernetes.io/aws-load-balancer-scheme" "internal"