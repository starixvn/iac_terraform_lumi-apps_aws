/*
output "lb_address" {
  #value       = length(kubernetes_service.lb.load_balancer_ingress) > 0 ? (length(kubernetes_service.lb.load_balancer_ingress[0].ip) > 0 ? kubernetes_service.lb.load_balancer_ingress[0].ip : kubernetes_service.lb.load_balancer_ingress[0].hostname) : "127.0.0.1"
  # value       = "example.org"
  value       = module.haproxy-ingress-controller.lb_address
  description = "The hostname of the LB created by kubernetes"
}

output "lb_addingress_classress" {
  value       = module.haproxy-ingress-controller.ingress_class
  description = "ingress_class"
}

output "helm_release_hap" {
  value = helm_release.haproxy-ingress-controller
  sensitive = true
}
*/
/*
resource "kubernetes_service" "lb" {
  metadata {
    name = "haproxy-ingress-controller-kubernetes-ingress"
    namespace = "haproxy"
    labels = {
      "run" = "haproxy-ingress"
    }
    annotations = {
    "service.beta.kubernetes.io/aws-load-balancer-name": "eks-lb"
    "service.beta.kubernetes.io/aws-load-balancer-type": "nlb"
    "service.beta.kubernetes.io/aws-load-balancer-scheme": "internet-facing"
    "service.beta.kubernetes.io/aws-load-balancer-connection-idle-timeout": 360
    "service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags": "Dept=VNTeam, Team=${local.team}, ManageBy=vnTerraform, Environment=${local.environment}"
  }
  }
  spec {
    
    type = "LoadBalancer"
    external_traffic_policy = "Local"

    selector = {
      "run" = "haproxy-ingress"
    }
    

    port {
            name        = "http"
            port        = 80
            target_port = 80
            protocol    = "TCP"
          }
    port {
            name        = "https"
            port        = 443
            target_port = 443
            protocol    = "TCP"
          }
          
  }
}
*/