locals {
  nodes_count = var.sc_web_instance_count
}

resource "random_pet" "this" {
  length = 1
}

# Terraform AWS Application Load Balancer (ALB)
module "lumi_nlb_internet" {
  source  = "terraform-aws-modules/alb/aws"
  version = "5.16.0"

  name               = "nlb-internet-lumi-${local.environment}"
  load_balancer_type = "network" #network application
  vpc_id             = data.terraform_remote_state.vpc.outputs.vpc_id
  subnets = [
    data.terraform_remote_state.vpc.outputs.public_subnets[0]
  ]
  # Listeners
  http_tcp_listeners = [
    {
      port               = 80
      protocol           = "TCP"
      target_group_index = 0
    },
    {
      port               = 443
      protocol           = "TCP"
      target_group_index = 1
    },
    {
      port               = 22222
      protocol           = "TCP"
      target_group_index = 2
    },
    {
      port               = 9001
      protocol           = "TCP"
      target_group_index = 3
    },
  ]

  # Target Groups
  target_groups = [
    # App1 Target Group - TG Index = 0
    {
      name                 = "sc-${local.project}-tg-80"
      backend_protocol     = "TCP"
      backend_port         = 80
      target_type          = "ip"
      deregistration_delay = 10
      protocol_version     = "HTTP1"
      # App1 Target Group - Targets
      targets = {
        my_hap_core1 = {
          target_id = module.hap-core.ec2_private_ip[0]
          port      = 80
        }
      }
      tags = local.common_tags # Target Group Tags
    },
    {
      name                 = "sc-${local.project}-tg-443"
      backend_protocol     = "TCP"
      backend_port         = 443
      target_type          = "ip"
      deregistration_delay = 10
      protocol_version     = "HTTP1"
      # App1 Target Group - Targets
      targets = {
        my_hap_core2 = {
          target_id = module.hap-core.ec2_private_ip[0]
          port      = 443
        }
      }
      tags = local.common_tags # Target Group Tags
    },
    {
      name                 = "sc-${local.project}-deployapi"
      backend_protocol     = "TCP"
      backend_port         = 22222
      deregistration_delay = 10
      protocol_version     = "HTTP1"
      target_type      = "ip"
      health_check = {
        enabled             = true
        interval            = 10
        path                = "/"
        port                = "traffic-port"
        healthy_threshold   = 2
        unhealthy_threshold = 2
        timeout             = 3
      }
      targets = {
        for i in range(local.nodes_count):
        i => {
          target_id = module.lumi-web-vm.ec2_private_ip[i]
          port      = 22222
        }
      }
      tags = local.common_tags # Target Group Tags
    },
    {
      name                 = "sc-${local.project}-portainer"
      backend_protocol     = "TCP"
      backend_port         = 9001
      target_type          = "ip"
      deregistration_delay = 10
      protocol_version     = "HTTP1"
      
      targets = {
        for i in range(local.nodes_count):
        i => {
          target_id = module.lumi-web-vm.ec2_private_ip[i]
          port      = 9001
        }
      }
      tags = local.common_tags # Target Group Tags
    }
  ]
  tags = local.common_tags # ALB Tags
}
